  greetHint: "\u6309\u6273\u673A\u6253\u62DB\u547C\uFF0C\u5E26\u4ED6\u53BB\u4E8C\u5C42\u907F\u96BE\u533A\nPress
    trigger to signal; lead them to the 2F refuge"
  leadText: "\u5DF2\u63A5\u5E94\uFF0C\u8DDF\u6211\u8D70\uFF0C\u524D\u5F80\u4E8C\u5C42\u907F\u96BE\u533A\nFollow
    me to the 2F refuge"
  doneText: "\u540C\u5B66\u5DF2\u5B89\u5168\u9001\u8FBE\u907F\u96BE\u533A\nStudent
    delivered to the 2F refuge"
